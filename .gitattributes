# Normalize all text files to LF in the repo; check out as LF everywhere.
# This prevents CRLF from sneaking in from Windows editors.
* text=auto eol=lf

# cmd.exe mis-parses labels and line continuations with LF endings.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Explicitly binary — never mangle these.
*.bin    binary
*.elf    binary
*.hex    binary
*.png    binary
*.jpg    binary
